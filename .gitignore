# Python
.venv/
__pycache__/
*.py[cod]
.ruff_cache/
.pytest_cache/

# 환경변수 — 서버 로컬에만 두고 Git·이미지에 넣지 않는다
.env
.env.*
!.env.example

# macOS
.DS_Store

# 로컬 전용 chat 테스트 화면 (BE 연동 시작하면 필요 없어짐)
dev/

# ⑦ 평가 실행 결과 원본(실제 모델 호출 기록). 저장소에는 올리지 않는다
evals/agent/results/
# ④⑥ 평가 실행 결과(--out). 책 표가 PC 마다 달라 저장소에 올리지 않는다. 기준선만 evals/feed/baseline.json 에 둔다
evals/feed/results/
# ③ 평가 실행 원본·요약(--out). 모델 호출 기록이라 저장소에는 올리지 않는다. 기준선만 evals/chat/baselines/ 에 둔다
evals/chat/results/
# ① 평가 실행 결과(--out). 책 표가 PC 마다 달라 저장소에 올리지 않는다. 기준선만 evals/search/baseline.json 에 둔다
evals/search/results/

# ③ 단계별 측정 원본·채점 중간 파일(evals/chat_stages). 모델 호출 기록이라 올리지 않는다
evals/chat_stages/results/

# data/ 의 다른 파일(정보나루 원본 usage.jsonl 등)은 올리지 않는다. ③ 그래프·인기 책 파일과 출처 안내만 올린다(정보나루 공개 배포 허락, 11/10)
data/*
!data/reading_graph.json.gz
!data/popular_books.json.gz
!data/README.md
