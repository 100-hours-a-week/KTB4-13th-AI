# AI 서버 환경변수 템플릿
#
# 이 파일은 Git에 올린다. 키 이름과 설명만 두고 실제 값은 넣지 않는다.
# 각자 이 파일을 복사해 .env 로 만들고 자기 값을 채운다.
#
#   cp .env.example .env
#
# 운영에서는 .env.production 을 서버 로컬에만 두고, 비밀값은
# SSM Parameter Store(SecureString)로 관리한다.


# ---------------------------------------------------------------------------
# 서버 — 이름은 클라우드 파트 compose.ai.yml 에서 이미 고정된 것
# ---------------------------------------------------------------------------

HOST=0.0.0.0
PORT=8000

# 표시 기준 시간대. 한국은 서머타임이 없어 KST = UTC+9 고정이다.
# 중요한 건 타임존이 아니라 컬럼 타입(timestamptz)이다.
TZ=Asia/Seoul

# 구조화 로그 레벨 (DEBUG / INFO / WARNING / ERROR)
LOG_LEVEL=INFO

# 배포된 커밋 해시 7자. ⑧ /health 의 version 이자 로그의 Release SHA.
# CI가 이미지 태그(= Git commit SHA)와 같은 값을 주입한다. 로컬은 dev.
RELEASE_SHA=dev


# ---------------------------------------------------------------------------
# AI 전용 PostgreSQL — ⑧ 부터 필요
# ---------------------------------------------------------------------------

# 형식: postgresql://<계정>:<비밀번호>@<호스트>:<포트>/<DB명>
# 로컬 개발은 비밀번호 없이 쓸 수 있다: postgresql://<계정>@127.0.0.1:5432/bookjeok_ai_dev
DATABASE_URL=

# 커넥션 풀 크기. 조회 경로와 생성 경로가 같은 DB를 쓰므로 너무 크게 잡지 않는다.
DB_POOL_MIN=1
DB_POOL_MAX=10


# ---------------------------------------------------------------------------
# 인증 — ① 부터 필요
# ---------------------------------------------------------------------------

# BE→AI 호출에 쓰는 서비스 토큰. Authorization: Bearer <값> 으로 온다.
# 없거나 틀리면 401. /health 만 예외.
# BE와 같은 값을 공유해야 하며, 팀 채널이 아니라 SSM으로 주고받는다.
AI_SERVICE_TOKEN=

# ①④ 목록 API의 커서 서명 키. 커서는 서버가 서명한 불투명 문자열이라
# 이 값이 서버마다 다르면 커서가 410으로 거부된다. 모든 인스턴스에 같은 값.
CURSOR_SIGNING_KEY=


# ---------------------------------------------------------------------------
# 임베딩 — ② 부터 필요. 자체 서빙(CPU)
# ---------------------------------------------------------------------------

# 2026-09-16 확정. 차원 384가 DDL(vector(384))에 박혀 있어
# 이 값을 바꾸면 book_embeddings·taste_profile 을 전량 재생성해야 한다.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384

# 파이썬 추론은 스레드로 처리량이 늘지 않아 프로세스 수로 늘린다.
# 실측상 동시성 4에서 꺾인다(175→230→159 RPS).
WORKER_COUNT=4


# ---------------------------------------------------------------------------
# 외부 LLM — ③ 부터 필요. 상용 API를 게이트웨이 어댑터 뒤에 둔다
# ---------------------------------------------------------------------------

EXTERNAL_AI_API_KEY=

# 모델·프롬프트를 바꾸는 PR에는 Provider·Model ID·Prompt Version과
# 고정 Dataset 검증 결과를 적어야 한다(팀 Git 컨벤션 5.6).
LLM_PROVIDER=
LLM_MODEL_ID=
# 로컬 개발 기본값 = Ollama(OpenAI 호환 엔드포인트). 상용 API로 바꿀 땐
# base_url·api_key만 바꾸면 되게 게이트웨이 어댑터 뒤에 둔다(app/core/llm.py)
LLM_BASE_URL=http://localhost:11434/v1
PROMPT_VERSION=v1

# 생성 경로 상한. 30초를 넘기면 504 generation_timeout.
LLM_TIMEOUT_SECONDS=30

# 통합 테스트에서 외부 LLM 대신 모의 응답을 쓴다(CD 파이프라인이 요구).
LLM_MOCK=false
