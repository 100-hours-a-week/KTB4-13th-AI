# AI 서버 환경변수 템플릿
#
# 이 파일은 Git에 올린다. 키 이름과 설명만 두고 실제 값은 넣지 않는다.
# 각자 이 파일을 복사해 .env 로 만들고 자기 값을 채운다.
#
#   cp .env.example .env
#
# 운영에서는 .env.production 을 서버 로컬에만 두고, 비밀값은
# SSM Parameter Store(SecureString)로 관리한다.


# ---------------------------------------------------------------------------
# 서버 — 이름은 클라우드 파트 compose.ai.yml 에서 이미 고정된 것
# ---------------------------------------------------------------------------

HOST=0.0.0.0
PORT=8000

# 표시 기준 시간대. 한국은 서머타임이 없어 KST = UTC+9 고정이다.
# 중요한 건 타임존이 아니라 컬럼 타입(timestamptz)이다.
TZ=Asia/Seoul

# 구조화 로그 레벨 (DEBUG / INFO / WARNING / ERROR)
LOG_LEVEL=INFO

# 배포된 커밋 해시 7자. ⑧ /health 의 version 이자 로그의 Release SHA.
# CI가 이미지 태그(= Git commit SHA)와 같은 값을 주입한다. 로컬은 dev.
RELEASE_SHA=dev


# ---------------------------------------------------------------------------
# AI 전용 PostgreSQL — ⑧ 부터 필요
# ---------------------------------------------------------------------------

# 형식: postgresql://<계정>:<비밀번호>@<호스트>:<포트>/<DB명>
# 로컬 개발은 비밀번호 없이 쓸 수 있다: postgresql://<계정>@127.0.0.1:5432/bookjeok_ai_dev
DATABASE_URL=

# 커넥션 풀 크기. 조회 경로와 생성 경로가 같은 DB를 쓰므로 너무 크게 잡지 않는다.
DB_POOL_MIN=1
DB_POOL_MAX=10


# ---------------------------------------------------------------------------
# 인증 — ① 부터 필요
# ---------------------------------------------------------------------------

# BE→AI 호출에 쓰는 서비스 토큰. Authorization: Bearer <값> 으로 온다.
# 없거나 틀리면 401. /health 만 예외.
# 임시로 비워 두면 검사하지 않는다(#261). 서버가 뜰 때 경고 로그만 남긴다.
# BE와 같은 값을 공유해야 하며, 팀 채널이 아니라 SSM으로 주고받는다.
AI_SERVICE_TOKEN=

# ①④ 목록 API의 커서 서명 키. 커서는 서버가 서명한 불투명 문자열이라
# 이 값이 서버마다 다르면 커서가 410으로 거부된다. 모든 인스턴스에 같은 값.
CURSOR_SIGNING_KEY=


# ---------------------------------------------------------------------------
# 임베딩 — ② 부터 필요. 자체 서빙(CPU)
# ---------------------------------------------------------------------------

# 2026-09-16 확정. 차원 384가 DDL(vector(384))에 박혀 있어
# 이 값을 바꾸면 book_embeddings·taste_profile 을 전량 재생성해야 한다.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384

# 파이썬 추론은 스레드로 처리량이 늘지 않아 프로세스 수로 늘린다.
# 실측상 동시성 4에서 꺾인다(175→230→159 RPS).
WORKER_COUNT=4


# ---------------------------------------------------------------------------
# 외부 LLM — ③ 부터 필요. 상용 API를 게이트웨이 어댑터 뒤에 둔다
# ---------------------------------------------------------------------------

EXTERNAL_AI_API_KEY=

# 모델·프롬프트를 바꾸는 PR에는 Provider·Model ID·Prompt Version과
# 고정 Dataset 검증 결과를 적어야 한다(팀 Git 컨벤션 5.6).
LLM_PROVIDER=
LLM_MODEL_ID=qwen2.5:7b
# 로컬 개발 기본값 = Ollama(OpenAI 호환 엔드포인트). 상용 API로 바꿀 땐
# base_url·api_key만 바꾸면 되게 게이트웨이 어댑터 뒤에 둔다(app/gateway/llm.py)
# 예) Gemini로 바꿀 때: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#     LLM_MODEL_ID=<AI Studio에서 확인한 모델명>, EXTERNAL_AI_API_KEY=<발급받은 키>
# 예) OpenRouter로 바꿀 때: LLM_BASE_URL=https://openrouter.ai/api/v1
#     LLM_MODEL_ID=<provider/model, 예: openai/gpt-4o-mini>, EXTERNAL_AI_API_KEY=<발급받은 키>
#     JSON 모드(response_format=json_object) 지원 모델인지 확인 필요(app/gateway/llm.py)
#     도구 호출(⑦)을 쓰는 곳은 ZDR과 도구를 같이 지원하는 모델이어야 한다. 2026-10-12 실측:
#     openai/gpt-4o-mini는 404, openai/gpt-4o·gpt-5.4-mini·gpt-5.4-nano는 됨(#345)
# ⑤ 취향 뽑기만 쓰는 모델. 비우면 LLM_MODEL_ID 를 쓴다. 평가(evals/extraction)는 아래 모델로 쟀다.
# 예: openai/gpt-4o-mini
EXTRACTION_LLM_MODEL_ID=
# ⑤ 취향 뽑기를 자체 서빙 LLM(GPU 서버의 vLLM 등 OpenAI 호환 주소)으로 먼저 부른다(#569). 실패하거나 시간을
# 넘기면 위 API 로 다시 부른다. 주소가 비면 API 만 쓴다. 켜고 끄기(EXTRACTION_SELF_HOSTED_MODE, 기본 on)와 모델 이름
# (EXTRACTION_SELF_HOSTED_MODEL_ID, 기본 bookjeok-extraction)은 코드 기본값을 쓴다. 여기 적으면 빈 값이어도 기본값을
# 덮으므로 적지 않는다.
# 예: http://<GPU 서버>:8000/v1
EXTRACTION_SELF_HOSTED_BASE_URL=
# 자체 서빙 서버가 키를 검사할 때만 채운다(vLLM --api-key). EXTERNAL_AI_API_KEY 는 이 서버로 보내지 않는다.
EXTRACTION_SELF_HOSTED_API_KEY=
# 자체 서빙 호출 하나의 제한(초). API 로 다시 부르는 시간까지 합쳐도 LLM_TIMEOUT_SECONDS 안에 들게 짧게 둔다.
EXTRACTION_SELF_HOSTED_TIMEOUT_SECONDS=10
# ③ 대화가 이어질 때 "새 책 찾기인지" 판정하는 호출만 쓰는 모델. 비우면 LLM_MODEL_ID 를 쓴다(#513).
# 이어지는 턴마다 한 번 더 도는 짧은 분류라 작은 모델이면 된다. 평가는 openai/gpt-4o-mini 로 쟀다.
# 예: openai/gpt-4o-mini
RELATION_LLM_MODEL_ID=
# ③ 문지기의 애매한 말 판정과 새 요청 판정을 판정 전용 모델 Jev 로 묻는다(CHAT_JUDGE=jev, 기본 llm). EXTERNAL_AI_API_KEY
# (OpenRouter 키)로 부르고, LLM_PROVIDER=openrouter(ZDR 켬)면 켜도 쓰지 않는다. 켜고 끄기와 모델 이름(JEV_MODEL_ID)은
# 코드 기본값을 쓴다. 여기 적으면 기본값을 덮으므로 적지 않는다. 로컬에서 켜 볼 때만 명령 앞에 CHAT_JUDGE=jev 를 붙인다.
# ③ 분위기 요청 후보를 외부 리랭커 API(OpenRouter rerank, 기본 cohere/rerank-5-fast)로 다시 줄 세운다(CHAT_RERANKER, 기본 false,
# #638). EXTERNAL_AI_API_KEY 로 부르고, LLM_PROVIDER=openrouter(ZDR 켬)면 켜도 쓰지 않는다. 켜고 끄기·모델 이름
# (RERANKER_MODEL_ID)·제한 시간(RERANKER_TIMEOUT_SECONDS)은 코드 기본값을 쓴다. 로컬에서 켜 볼 때만 명령 앞에 CHAT_RERANKER=true 를 붙인다.
LLM_BASE_URL=http://localhost:11434/v1
PROMPT_VERSION=v1

# 생성 경로 상한. 30초를 넘기면 504 generation_timeout.
LLM_TIMEOUT_SECONDS=30

# 통합 테스트에서 외부 LLM 대신 모의 응답을 쓴다(CD 파이프라인이 요구).
LLM_MOCK=false

# ⑦ 쇼핑 에이전트만 쓰는 모델. 비우면 LLM_MODEL_ID 를 쓴다. ZDR 과 도구 호출을 같이 지원해야 한다.
# 예: openai/gpt-5.4-mini
AGENT_LLM_MODEL_ID=

# ⑦ 진짜 BE 장바구니 연결 전(11단계)까지 로컬에서만 true 로 켠다. 꺼져 있으면 /agent/act 는 503 이다.
COMMERCE_MOCK=false

# ⑦ 한 턴의 시간 제한(초). 넘기면 504 generation_timeout. LLM_TIMEOUT_SECONDS 는 LLM 호출 하나의 제한이다.
AGENT_TURN_TIMEOUT_SECONDS=30

# ⑦ 카드 밖 책 찾기·주문 화면·쿠폰과 포인트(#631). BE#533 이 배포된 뒤에만 true 로 켠다. 그 전에 켜면 BE 가
# 목록 밖 ISBN 과 주문 화면 목적지를 거절해 턴이 실패한다.
AGENT_CHECKOUT=false
# ⑦ 책 정보·리뷰(#650): "몇 권 남았어?", "리뷰 어때?", "쿠폰 있어?"에 BE 공개 상품 상세·리뷰·쿠폰으로 답한다.
# 아래 BE_PUBLIC_API_BASE_URL 이 있어야 한다. 켜면 문지기도 리뷰·평점·쿠폰·남은 수량 말을 ⑦로 보낸다.
AGENT_BOOK_INFO=false
# BE 공개 API 주소(로그인 없이 읽는 검색·상품 상세·리뷰·쿠폰만 부른다). 비어 있으면 책 찾기·책 정보를 하지 않는다.
# 예: https://bookjeok.site  (COMMERCE_MOCK=true 면 비워도 가공의 서가로 찾는다)
BE_PUBLIC_API_BASE_URL=
BE_PUBLIC_API_TIMEOUT_SECONDS=5

# 사진으로 책 찾기(#615). 사진 속 글자를 읽는 모델. 비우면 LLM_MODEL_ID 를 쓴다. 사진을 받는 모델이어야 한다.
# 예: google/gemini-4-argon
PHOTO_LLM_MODEL_ID=
# 사진 주소(image_ref)가 이 중 하나로 시작할 때만 연다. 쉼표로 여러 개. 비우면 어떤 주소도 열지 않는다.
# 예: https://<버킷>.s3.ap-northeast-2.amazonaws.com/<사진 폴더>/  (로컬 시험: http://127.0.0.1:8001/)
PHOTO_IMAGE_URL_PREFIXES=
# 사진 한 장의 시간 제한(초). 넘기면 504 generation_timeout.
PHOTO_TIMEOUT_SECONDS=60

# 카프카로 프로필 계산 요청 받기(#666). BE 가 PUT /preferences/profile 과 같은 본문을 이 토픽으로도 보낸다(BE #551).
# true 로 켜면 서버가 뜰 때 소비자를 띄운다. 켜려면 브로커 주소와 소비자 그룹(환경마다 다르게)이 있어야 한다.
PROFILE_KAFKA_ENABLED=false
# 예: localhost:9092  (쉼표로 여러 개)
KAFKA_BOOTSTRAP_SERVERS=
# 예: book-ai-profile-v1-dev  (같은 환경의 AI 서버들은 같은 그룹을 쓴다)
PROFILE_KAFKA_GROUP_ID=


# ---------------------------------------------------------------------------
# 로컬 개발 전용 — dev/ 테스트 화면에서 브라우저로 이 서버를 직접 호출할 때만 필요
# ---------------------------------------------------------------------------

# 값을 채우면 그 origin(들, 콤마 구분)에서 오는 브라우저 요청에 CORS를 허용한다.
# 비어있으면(기본) 아무 효과 없다. 예: http://localhost:5500
# BE 연동을 시작하면 이 줄과 dev/ 폴더를 함께 지운다.
DEV_CORS_ORIGINS=
